<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClCompile Include="native\fastchunk\*.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="native\fastchunk\*.h" />
  </ItemGroup>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <OutDir>build\</OutDir>
    <TargetName>fastchunk</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup ClCompile>
    <AdditionalIncludeDirectories>
      %JAVA_HOME%\include;%JAVA_HOME%\include\win32
    </AdditionalIncludeDirectories>
    <PreprocessorDefinitions>_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS</PreprocessorDefinitions>
    <Optimization>MaxSpeed</Optimization>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Link>
    <SubSystem>Windows</SubSystem>
    <EntryPointSymbol>DllMain</EntryPointSymbol>
  </ItemDefinitionGroup>
</Project>
